# Copy this file to .env and fill in your values
# .env is gitignored — never commit real keys

# -- Gemini API ----------------------------------------------------------------
# Used by: agent orchestrator (LangGraph) + RAG explanation generation
# Get your key at: https://aistudio.google.com/app/apikey
# Free tier limits: 15 req/min, 1M tokens/day (as of 2024)
# NOTE: demo requires internet access — Gemini calls go to Google servers
GEMINI_API_KEY=your_gemini_api_key_here

# -- MongoDB -------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=dermatology

# -- JWT Auth ------------------------------------------------------------------
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# -- App -----------------------------------------------------------------------
ENVIRONMENT=development
