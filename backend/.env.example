# ==============================================================================
# DermaAI Backend — Environment Configuration
# Copy this file to .env and fill in the values before running the server.
# NEVER commit .env to version control.
# ==============================================================================

# ── MongoDB ────────────────────────────────────────────────────────────────────
# Local dev: mongodb://localhost:27017
# Docker:    mongodb://mongo:27017
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=dermatology

# ── JWT Auth ───────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_this_to_a_long_random_secret_key_min_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── Gemini API ─────────────────────────────────────────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
# If empty → agent runs with a fallback "no explanation" message
GEMINI_API_KEY=

# ── ML Model Checkpoint ────────────────────────────────────────────────────────
# Absolute or relative path to the trained EfficientNet-B0 .pth checkpoint.
# If empty or file not found → backend uses MOCK predictions (safe for UI testing).
MODEL_CHECKPOINT_PATH=

# ── File Storage ───────────────────────────────────────────────────────────────
# Directory where uploaded images and Grad-CAM PNGs are saved.
UPLOAD_DIR=uploads

# ── Application ────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=DermaAI API
API_PREFIX=/api
